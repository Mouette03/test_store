{
  "$schema": "https://schemas.runtipi.io/dynamic-compose.json",
  "schemaVersion": 2,
  "services": [
    {
      "name": "nextexplorer",
      "image": "nxzai/explorer:latest",
      "isMain": true,
      "internalPort": 3000,
      "environment": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "PUBLIC_URL",
          "value": "${APP_PROTOCOL}://${APP_DOMAIN}"
        },
        {
          "key": "SESSION_SECRET",
          "value": "${SESSION_SECRET}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/config"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/cache",
          "containerPath": "/cache"
        },
        {
          "hostPath": "${FILES_PATH}",
          "containerPath": "/mnt/Files"
        }
      ]
    }
  ]
}