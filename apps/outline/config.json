  "categories": ["utilities", "productivity"],
  "description": "Outline is a fast, open-source knowledge base app for team documentation with real-time collaboration. It supports Markdown, sharing, version history and search.",
  "short_desc": "Open source team wiki for knowledge sharing.",
  "author": "Outline",
  "website": "https://www.getoutline.com/",
  "source": "https://github.com/outline/outline",
  "form_fields": [
    {
      "type": "random",
      "label": "Database password",
      "min": 32,
      "env_variable": "OUTLINE_PG_PASSWORD"
    },
    {
      "type": "random",
      "label": "Secret key",
      "min": 64,
      "env_variable": "OUTLINE_SECRET_KEY"
    },
    {
      "type": "random",
      "label": "Utils secret",
      "min": 32,
      "env_variable": "OUTLINE_UTILS_SECRET"
    },
    {
      "type": "text",
