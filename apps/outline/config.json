      "required": false,
      "env_variable": "OUTLINE_SMTP_HOST"
    },
    {
      "type": "text",
      "label": "SMTP Port",
      "hint": "usually 587 or 465",
      "required": false,
      "env_variable": "OUTLINE_SMTP_PORT"
    },
    {
      "type": "text",
      "label": "SMTP Username",
      "required": false,
      "env_variable": "OUTLINE_SMTP_USER"
    },
    {
      "type": "password",
      "label": "SMTP Password",
      "required": false,
      "env_variable": "OUTLINE_SMTP_PASSWORD"
    },
    {
      "type": "text",
      "label": "SMTP From Email",
      "hint": "Sender email for Outline emails",
      "required": false,
      "env_variable": "OUTLINE_SMTP_FROM"
    },
    {
      "type": "text",
      "label": "OIDC Client ID",
      "required": false,
      "env_variable": "OUTLINE_OIDC_CLIENT_ID"
    },
    {
      "type": "password",
      "label": "OIDC Client Secret",
      "required": false,
      "env_variable": "OUTLINE_OIDC_CLIENT_SECRET"
    },
    {
      "type": "text",
      "label": "OIDC Authorization URI",
      "required": false,
      "env_variable": "OUTLINE_OIDC_AUTH_URI"
    },
    {
      "type": "text",
      "label": "OIDC Token URI",
      "required": false,
      "env_variable": "OUTLINE_OIDC_TOKEN_URI"
    },
    {
      "type": "text",
      "label": "OIDC UserInfo URI",
      "required": false,
      "env_variable": "OUTLINE_OIDC_USERINFO_URI"
    }
